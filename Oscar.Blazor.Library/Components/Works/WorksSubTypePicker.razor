@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudSelect value="@Value" For="@For" ValueChanged="@( (int? s) => OnSelectChange(s) )" Label="@Label" Class="@Class" Dense="true" Clearable>
    @if (_types != null)
    {
        @foreach (WorksSubTypeDto type in _types)
        {
            int? typeId = (int?)type.Id;
            <MudSelectItem Value="@typeId">@type.Name - @type.Description</MudSelectItem>
        }

    }
</MudSelect>