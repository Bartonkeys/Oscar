@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudCard Class="ma-3 pa-5" Elevation="5">
    @Header
    <MudPaper Class="d-flex flex-row mb-2" Elevation="0" >
        <MudAutocomplete T="SocietyDto" Label="@ListLabel" @bind-Value="_society" For="@(() => _society)" Required="false"
                            SearchFunc="@Search" ToStringFunc="@ListItemString" @onblur="onChange"
                            Dense="true" Margin="Margin.Dense">
            <MoreItemsTemplate>
                <MudText Align="Align.Center" Class="px-4 py-1">
                    Only the first 10 items are shown
                </MudText>
            </MoreItemsTemplate>
        </MudAutocomplete>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ma-2" OnClick="@AddReRegistration">Add</MudButton>
    </MudPaper>

    <MudTable Items="@Values" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info" Class="mb-2" Dense="true" >
        <RowTemplate>
            <MudTd Style="width: 90%;" Class="grey lighten-3 pa-0 pl-2">
                @ListItemString(context)
            </MudTd>
        
            <MudTd Style="width: 10%;" Class="grey lighten-3 pa-0 pl-2">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="delete" OnClick="@((e) => RemoveReRegistration(context))"></MudIconButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudCard>
