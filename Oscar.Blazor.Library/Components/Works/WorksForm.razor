@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@using Core.Enums

@if (_works != null)
{
    <MudText Typo="Typo.h6" Height="5%">
        @switch (_works.Discriminator)
        {
            case "StandAlone":
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.Man" Title="StandAlone" />
                break;
            case "Episode":
                <MudIcon Color="Color.Warning" Icon="@Icons.Material.Filled.Theaters" Title="Episode" />
                break;
            case "Season":
                <MudIcon Color="Color.Success" Icon="@Icons.Material.Filled.WbSunny" Title="Season" />
                break;
            case "Series":
                <MudIcon Color="Color.Secondary" Icon="@Icons.Material.Filled.AutoAwesomeMotion" Title="Series" />
                break;
            default:
                <span></span>
                break;
        }
        Edit @_works.Discriminator
    </MudText>
    <MudCard Height="90%" Class="overflow-auto pb-4">
        <MudForm Model="@_works" @ref="@form" Validation="@(worksValidator.ValidateValue)" ValidationDelay="0" OnInvalidSubmit="@HandleInvalidSubmit()">
            <Titles @bind-Value="_works.Titles"  Class="pl-4 pt-2 pr-4" IsEpisode="@_isEpisode"></Titles>
            <YearPicker Label="Production Year" @bind-Value="_works.ProductionYear" For="@(() => _works.ProductionYear)" Class="pl-4 pt-2 pr-4"></YearPicker>
            <YearPicker Label="First Broadcast Year" @bind-Value="_works.FirstBroadcastYear" For="@(() => _works.FirstBroadcastYear)" Class="pl-4 pt-2 pr-4"></YearPicker>
            <StatusPicker @bind-Value="_works.WorksStatus" For="@(() => _works.WorksStatus)" Label="Status" Class="pl-4 pt-2 pr-4" InvalidStatuses="@(new List<WorksStatus>() {WorksStatus.Any})"></StatusPicker>
            <GenrePicker @bind-Value="_works.GenreId" For="@(() => _works.GenreId)" Label="Genre" Class="pl-4 pt-2 pr-4"></GenrePicker>
            <MudNumericField @bind-Value="_works.DurationMinutes" For="@(() => _works.DurationMinutes)" Label="Duration(mins)" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudNumericField>
            <MudTextField @bind-Value="_works.Number" For="@(() => _works.Number)" Label="Number" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            <MudTextField @bind-Value="_works.IMaestroWorkCode" For="@(() => _works.IMaestroWorkCode)" Label="iMaestro Work Code" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            <MudTextField @bind-Value="_works.AgicoaWorksReference" For="@(() => _works.AgicoaWorksReference)" Label="Agicoa Works Reference" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            <MudTextField @bind-Value="_works.Isan" For="@(() => _works.Isan)" Label="Isan" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            <MudTextField @bind-Value="_works.CavcoCode" For="@(() => _works.CavcoCode)" Label="CavcoCode" Variant="Variant.Text" Class="pl-4 pt-2 pr-4" MaxLength="15"></MudTextField>
            <MudTextField @bind-Value="_works.CrtcCode" For="@(() => _works.CrtcCode)" Label="CrtcCode" Variant="Variant.Text" Class="pl-4 pt-2 pr-4" MaxLength="10"></MudTextField>
            <MudTextField @bind-Value="_works.GeneralNotes" For="@(() => _works.GeneralNotes)" Label="General Notes" Lines="3" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>

            @*<MudCard>
            <MudCardHeader>Seasons</MudCardHeader>
            <MudCardContent>
                <MudTable Items="@_works.Seasons" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
                    <RowTemplate>
                        <MudTd>
                            <MudForm Model="@context" Validation=@(titleValidator.ValidateValue)>
                                <MudTextField @bind-Value="context.Title" For="@(() => context.Title)" Label="Title" Variant="Variant.Text"></MudTextField>
                            </MudForm>
                        </MudTd>
                        <MudTd>
                            <MudSelect @bind-Value="context.LanguageCode" For="@(() => context.LanguageCode)" Label="language">
                                @foreach (LanguageDto lang in _languages)
                                {
                                    <MudSelectItem Value="@lang.Name.ToUpper()">@lang.Description</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd DataLabel="Name">
        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="delete" OnClick="@(async () => removeTitle(context))"></MudIconButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto mt-2" OnClick="@(async () => addTitle())">Add Title</MudButton>
            </MudCardContent>
        </MudCard>*@

        </MudForm>

    </MudCard>
    <MudCardActions Height="5%">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@(async () => await Submit())">Save Work</MudButton>
    </MudCardActions>
}
else
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}