@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudDrawer @bind-Open="@_openWorksDrawer" Height="100%" Width="50%" Style="padding: 20px" Anchor="@Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary">
    <SeasonForm Id="@_seasonId" SeriesId="@SeriesId" @bind-Open="_openWorksDrawer" RefreshParent="@refreshParent" OpenParent="@OpenParent"></SeasonForm>
</MudDrawer>
<MudCard Class="ma-3 pa-5" Elevation="5">
    Seasons
    <MudTable Items="@Value" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info" Class="mb-2 mt-1" Dense="true" >
        <RowTemplate>
            <MudTd Style="width: 80%;" Class="grey lighten-3 pa-0 pl-2">
                @context.Titles.First().Title
            </MudTd>
            <MudTd Style="width: 20%;" Class="grey lighten-3 pa-0 pl-2">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="delete" OnClick="@(async () => OpenWorksDrawer(context.Id))"></MudIconButton>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="delete" OnClick="@(async () => removeSeason(context))"></MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" Size="Size.Small" aria-label="delete" OnClick="@(async () => copySeason(context))"></MudIconButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto mt-2" OnClick="@(async () => OpenWorksDrawer(0))">Add Season</MudButton>
</MudCard>