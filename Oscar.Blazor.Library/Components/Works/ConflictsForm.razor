@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@using Core.Enums
@using Oscar.Blazor.Library.Components.Common

@if (ConflictDto != null)
{
    <div Class="d-flex flex-row pb-2">
        <MudIcon Color="Color.Secondary" Icon="@Icons.Material.Filled.List" Title="Conflict" Class="mr-2" />
        @if (ConflictDto.Id < 1)
        {
            <MudText> Add Conflict</MudText>
        }
        else
        {
            <MudText> Edit Conflict</MudText>
        }
    </div>
    <MudCard Height="90%" Class="overflow-auto pb-4">
        <MudForm Model="@ConflictDto" @ref="@form" Validation="@(conflictsValidator.ValidateValue)">
            <MudCheckBox @bind-Value="@ConflictDto.Internal" Label="Internal"></MudCheckBox>
            <MudSelect Class="pl-4 pt-2 pr-4" T="int" @bind-Value="ConflictDto.SocietyId" For="@(() => ConflictDto.SocietyId)" Label="Society" Dense="true" Margin="Margin.Dense">
                <MudSelectItem Value="0">@string.Empty</MudSelectItem>
                @foreach (var society in Societies)
                {
                    <MudSelectItem Value="@society.Id">@society.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker Class="pl-4 pt-2 pr-4" @bind-Date="@ConflictDto.NotationDate" For="@(() => ConflictDto.NotationDate)" DateFormat="dd-MMM-yyyy" Label="Notation Start Date"></MudDatePicker>
            <MudTextField @bind-Value="ConflictDto.Notes" For="@(() => ConflictDto.Notes)" Label="Notes" Variant="Variant.Text" Lines="3" Class="pl-4 pt-2 pr-4"></MudTextField>
        </MudForm>

        <MudCardActions Height="5%">
            <MudItem xs="6">
                <MudButton Disabled="@_processing" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto" OnClick="@(async () => await Submit())">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">SAVING</MudText>
                    }
                    else
                    {
                        <MudText>SAVE CONFLICT</MudText>
                    }
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="ml-auto" OnClick="@Cancel">
                    <MudText>Cancel</MudText>
                </MudButton>
            </MudItem>
        </MudCardActions>
    </MudCard>
}
else
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
}