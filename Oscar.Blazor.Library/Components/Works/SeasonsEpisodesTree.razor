@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@using Oscar.Infrastructure.Features.Series.Queries
<MudDrawer @bind-Open="@_openWorksDrawer" Height="100%" Width="50%" Style="padding: 20px" Anchor="@Anchor.End" Elevation="1" Variant="@DrawerVariant.Persistent" ClipMode="DrawerClipMode.Docked">
    @switch (_discriminator)
    {
        case Discriminator.Season:
            <SeasonForm Id="@_selectedId" ExistingSeasons="@Seasons" SeriesId="@SeriesId" ParentSeries="@ParentSeries" Open="_openWorksDrawer" RefreshParent="@refreshParent" OpenParent="@OpenParent" toggleWorksDrawer="@ToggleWorksDrawer"></SeasonForm>
            break;
        case Discriminator.Episode:
            <EpisodeForm Id="@_selectedId" SeasonId="@_seasonId" SeriesId="@SeriesId" Open="_openWorksDrawer" RefreshParent="@refreshParent" OpenParent="@OpenParent" toggleWorksDrawer="@ToggleWorksDrawer"></EpisodeForm>
            break;
        default:
            <span>blah</span>
            break;
    }
</MudDrawer>
<MudDrawer @bind-Open="@openCopyDrawer" Height="100%" Width="50%" Style="padding: 20px" Anchor="@Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary">
    <CopyForm WorksToCopy="@selectedItems" WorksSource="WorksSource.WorksDetail" CopyFormComplete="CopyFormComplete"></CopyForm>
</MudDrawer>
<MudCard Class="ma-3 pa-5" Elevation="5">
    <MudText>Seasons and Episodes</MudText>
    <MudText><b>Client</b>: @OwningClient</MudText>
    <MudText><b>Catalogue</b>: @OwningCatalogue</MudText>
    @if (@_loading == false)
    {
        <MudTreeView T="TreeItemData" Items="@TreeItemsView" Dense="true" ReadOnly="true">
            <ItemTemplate>
                <MudTreeViewItem T="TreeItemData" @bind-Expanded="@context.Value.IsExpanded" Items="@context.Children" Value="@context.Value">
                    <Content>
                        <MudTreeViewItemToggleButton @bind-Expanded="@context.Value.IsExpanded" Visible="@context.Value.HasChild" />
                        <MudText>@context.Value.Title</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Style="@(context.Value.Discriminator == Discriminator.All ? "display:none;" : null)" aria-label="edit" OnClick="@(async () => OpenWorksDrawer(context.Value))"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" Style="@(context.Value.Discriminator == Discriminator.All ? "display:none;" : null)" aria-label="delete" OnClick="@(async () => removeItem(context.Value))"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary" Style="@(context.Value.Discriminator == Discriminator.All ? "display:none;" : null)"  aria-label="copy" OnClick="@(async () => OpenCopyDrawer(context.Value))"></MudIconButton>
                    </Content>
                </MudTreeViewItem>
            </ItemTemplate>
        </MudTreeView>
    }
    else
    {
        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto mt-2" OnClick="@(async () => OpenWorksDrawer(null))">Add Season</MudButton>
</MudCard>
