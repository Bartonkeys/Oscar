@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudCard Class="ma-3 pa-5" Style="@Style" Elevation="5">
    @Header
    <MudPaper Class="d-flex flex-row mb-2" Elevation="0">
        <MudAutocomplete T="CountryDto" Label="@ListLabel" @bind-Value="_country" For="@(() => _country)" Required="false" d
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Name}")" 
                         @onblur="onChange" Dense="true" Margin="Margin.Dense"
                         DebounceInterval="500" ShowProgressIndicator="true"
                         AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary">
            <NoItemsTemplate>
                <MudText Align="Align.Center" Class="px-4 py-1">
                    Please enter country name
                </MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ma-2" OnClick="@AddCountry" Size="Size.Small">Add</MudButton>
    </MudPaper>

    <MudTable Items="@Value" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info" Class="mb-2" Dense="true" >
        <RowTemplate>
            <MudTd Style="width: 90%;" Class="grey lighten-3 pa-0 pl-2">
                @context.Name
            </MudTd>
            <MudTd Style="width: 10%;" Class="grey lighten-3 pa-0 pl-2">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="delete" OnClick="@((e) => RemoveCountry(context))"></MudIconButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudCard>
