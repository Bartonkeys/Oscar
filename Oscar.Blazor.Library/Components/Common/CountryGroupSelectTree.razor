@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudCard Class="ma-3 pa-5" Elevation="5">
	@Header
	<MudPaper Elevation="0">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto" OnClick="@ClearAll">Clear All</MudButton>
		<MudCheckBox T="bool" Label="Show Selected" @ref = "showSelected" ValueChanged="@((isChecked) => ShowSelected(isChecked))"></MudCheckBox>
		
		<MudPaper Elevation="0">
			<MudTextField T="string" @bind-Value="searchValue" Label="Search"></MudTextField>
			<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto" OnClick="@Search">Search</MudButton>
		</MudPaper>

		<MudTreeView T="CountriesGroupsDto" Items="@CountriesGroupsTree" @ref="countriesGroupsTreeView" Height="400px" ReadOnly="true">
			<ItemTemplate>
					<MudTreeViewItem T="CountriesGroupsDto" Value="@context.Value" Items="@context.Children" @bind-Expanded="@context.Value.IsExpanded">
					<Content>
						<MudTreeViewItemToggleButton @bind-Expanded="@context.Value.IsExpanded" Visible="@context.Value.HasChild" />
						<MudCheckBox T="bool?" Value="@(context.Value.HasPartialChildSelected() ? null : context.Value.IsChecked)" ValueChanged="@((e) => TreeItemCheckedChanged(context.Value))"></MudCheckBox>
						<MudText>@context.Value.Name</MudText>
					</Content>
				</MudTreeViewItem>
			</ItemTemplate>
		</MudTreeView>
	</MudPaper>
</MudCard>

