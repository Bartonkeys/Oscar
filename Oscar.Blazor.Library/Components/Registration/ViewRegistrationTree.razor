@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudCard Class="ma-3 pa-5" Elevation="5">
    <MudPaper Elevation="0">
        <MudTextField T="string" @bind-Value="searchValue" Label="Search"></MudTextField>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto" OnClick="@Search">Search</MudButton>
        <MudCheckBox T="bool" Label="Select All" ValueChanged="@((isChecked) => SetIsChecked(isChecked))"></MudCheckBox>
    </MudPaper>

    <MudPaper Elevation="0">
        <MudTreeView T="RegistrationWorksDto" Items="@RegistrationWorksTree" Height="400px" @ref=_registrationWorksTreeView ReadOnly="true">
            <ItemTemplate>
                <MudTreeViewItem T="RegistrationWorksDto" Value="@context.Value" Items="@context.Children" @bind-Expanded="@context.Value.IsExpanded">
                    <Content>
                        <MudTreeViewItemToggleButton @bind-Expanded="@context.Value.IsExpanded" Visible="@context.Value.HasChild" />
                        <MudCheckBox T="bool?" Value="@context.Value.IsChecked" ValueChanged="@((e) => TreeItemCheckedChanged(context.Value))"></MudCheckBox>
                        <MudIcon Icon="@(
                                            context.Value?.Discriminator switch
                                            {
                                                Discriminator.StandAlone => Icons.Material.Filled.Man,
                                                Discriminator.Episode => Icons.Material.Filled.Theaters,
                                                Discriminator.Season => Icons.Material.Filled.WbSunny,
                                                Discriminator.Series => Icons.Material.Filled.AutoAwesomeMotion,
                                                _ => context.Value?.Discriminator.ToString()
                                            }
                                         )"
                                 Color="@(
                                            context.Value?.Discriminator switch
                                            {
                                                Discriminator.StandAlone => Color.Primary,
                                                Discriminator.Episode => Color.Warning,
                                                Discriminator.Season => Color.Success,
                                                Discriminator.Series => Color.Secondary,
                                                _ => Color.Default
                                            }
                                            )">
                        </MudIcon>
                        <MudText>@($"{context.Value?.CompactRef} {context.Value?.Title}")</MudText>
                    </Content>
                </MudTreeViewItem>
            </ItemTemplate>
        </MudTreeView>
    </MudPaper>

    <MudText Typo="@Typo.subtitle1">@(SelectedValues?.Count() > 0 ? $"Number of selected items: {SelectedValues?.Count()}" : "")</MudText>
    </MudCard>