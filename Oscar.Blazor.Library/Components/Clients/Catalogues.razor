@inherits Oscar.Blazor.Library.Common.OscarComponentBase

<MudDrawer @bind-Open="@openCatalogFormDrawer" Height="100%" Width="60%" Style="padding: 20px" Anchor="@Anchor.End" Elevation="1" Variant="@DrawerVariant.Persistent" ClipMode="DrawerClipMode.Docked">
    <CatalogueForm _catalogueId="@_catalogueId" _clientId="@_clientId" onSuccess="@SuccessCatalogueFormCallback" toggleDrawer="@ToggleDrawer"></CatalogueForm>
</MudDrawer>

<MudCard Class="ma-2 pa-2" Elevation="5">

    @*<MudCardHeader>Catalogues</MudCardHeader>*@
    <MudPaper Class="d-flex flex-row" Elevation="0">
    </MudPaper>

    <MudTable Items="@_catalogues" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info" Dense="true">
        <RowTemplate>
            <MudTd Style="width: 70%;">
                @context.Name
            </MudTd>
            <MudTd Style="width: 30%;">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="delete" OnClick="@((e) => RemoveCatalogue(context))"></MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" aria-label="delete" OnClick="@((e) => OpenCatalogForm(context.Id))"></MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.Link" Color="Color.Primary" Size="Size.Small" aria-label="works" OnClick="() => LoadCatalogueLinkedWorks(context)"></MudIconButton>


            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudExpansionPanels>
        <MudExpansionPanel Text="Create New Catalogue" MaxHeight="150" IsExpanded="@_showCreatePanel" IsExpandedChanged="@showHideCreateForm">
            <MudPaper Class="d-flex flex-row" Elevation="0">
                <MudTextField T="String" @bind-Value="_name" For="@(() => _name)" Label="Name" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
                <MudTextField T="String" @bind-Value="_reference" For="@(() => _reference)" Label="Reference" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
                <MudTextField T="String" @bind-Value="_iMaestroClientCode" For="@(() => _iMaestroClientCode)" Label="IMaestro Client Code" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            </MudPaper>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" Style="width:100%" Class="ml-auto mt-2" OnClick="@CreateCatalogue">Create and add to Client</MudButton>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudCard>