    <MudTextField @bind-Value="Client.MPAAClaimantsId" For="@(() => Client.MPAAClaimantsId)" Label="MPAA Claimants Id" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
