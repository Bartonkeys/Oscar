    <MudTextField @bind-Value="Client.CCCClientsId" For="@(() => Client.CCCClientsId)" Label="CCC Clients Id" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
    <MudTextField @bind-Value="Client.CRCClientsId" For="@(() => Client.CRCClientsId)" Label="CRC Clients Id" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
