@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@using Oscar.Blazor.Library.Components.Common
@using Oscar.Blazor.Library.Components.Rights

<MudText Typo="Typo.h6" Height="5%">
    <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.Man" Title="Edit Catalogue" />
    @if (_catalogueId == 0)
    {
        <MudText> Add New Catalogue</MudText>
    }
    else
    {
        <MudText> Edit Catalogue: @_name  </MudText>
    }

</MudText>

<MudExpansionPanels MultiExpansion="true">
    <MudExpansionPanel Text="Details" MaxHeight="170" IsExpanded="@_showDetailsPanel" IsExpandedChanged="@showHideDetailsPanel">
        <MudPaper Class="d-flex flex-row" Elevation="0">
            <MudTextField T="String" @bind-Value="_name" For="@(() => _name)" Label="Name" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            <MudTextField T="String" @bind-Value="_iMaestroClientCode" For="@(() => _iMaestroClientCode)" Label="IMaestro Client Code" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
            <MudTextField T="String" @bind-Value="_agicoaClientRef" For="@(() => _agicoaClientRef)" Label="Agicoa Client Ref" Variant="Variant.Text" Class="pl-4 pt-2 pr-4"></MudTextField>
        </MudPaper>
        <MudPaper Class="d-flex flex-row" Elevation="0">
            <MudTextField T="String" @bind-Value="_generalNotes" For="@(() => _generalNotes)" Label="General Notes" Variant="Variant.Text" Lines="3" Class="pl-4 pt-2 pr-4"></MudTextField>
        </MudPaper>
    </MudExpansionPanel>
    <MudExpansionPanel Class="overflow-scroll" Text="Societies" MaxHeight="150" IsExpanded="@_showSocietiesPanel" IsExpandedChanged="@showHideSocitiesPanel">
        <MudPaper Class="d-flex flex-row" Elevation="0">
            <MudTable Class="overflow-scroll" Items="@_societies" Hover="true" Dense="true" FixedHeader="true">
                <RowTemplate>
                    <MudTd DataLabel="society">@context.Name</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudExpansionPanel>
    <MudExpansionPanel Class="overflow-scroll" Text="Rights" MaxHeight="500" IsExpanded="@_showRightsPanel" IsExpandedChanged="@showHideRightsPanel">
        <RightsGrid Id="@_clientId" FilterCatID="@_catalogueId" DisableCatalogSelection="true" IsEditable="true" Open="@_showRightsPanel" onSuccess="@SuccessRightsCallback" RightsSource="@RightsSource.Catalogue"></RightsGrid>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Other Names" MaxHeight="150" IsExpanded="@_showOtherNamesPanel" IsExpandedChanged="@showHideOtherNamesPanel">
        <OtherNames @bind-Value="@_otherNames" CatalogueId="@_catalogueId"></OtherNames>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Mandates" MaxHeight="600" IsExpanded="@_showMandatesPanel" IsExpandedChanged="@showHideMandatesPanel">
        <Mandates MandateTypes="@_mandateTypes"></Mandates>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudCardActions Height="5%">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@UpdateCatalogue" Disabled="_isUpdating">Update Catalogue</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@Cancel" Disabled="_isUpdating">Cancel</MudButton>
</MudCardActions>