@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@inject AuthenticationStateProvider GetAuthenticationStateAsync

<MudOverlay Visible="_processing" DarkBackground="false">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                <MudText Align="Align.Center" Typo="Typo.h6">Uploading Screenrights...</MudText>
            </CardHeaderContent>
        </MudCardHeader>
    </MudCard>
</MudOverlay>

<MudCard>
    <MudForm Model="@model" @ref="@form" Validation="@(orderValidator.ValidateValue)" ValidationDelay="0">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.h6">@Title</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="model.RequestedBy"
                                  For="@(() => model.RequestedBy)"
                                  Immediate="true"
                                  Label="Requested By" />
                </MudItem>

                <MudDivider />

                <MudItem xs="12">
                    <div class="d-flex">
                        <InputFile for="@(() => model.ScreenrightsFile)" id="fileInput" OnChange="UploadFiles" hidden />

                        <MudButton HtmlTag="label"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Filled.CloudUpload"
                                   for="fileInput">
                            Upload Screenrights File
                        </MudButton>

                        @if (model.ScreenrightsFile != null)
                        {
                            <MudText>File: @model.ScreenrightsFile.Name <code>@model.ScreenrightsFile.Size bytes</code></MudText>
                        }
                    </div>
                </MudItem>
                <MudDivider />
            </MudGrid>
        </MudCardContent>
    </MudForm>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@(async () => await Submit())">Create Screenrights</MudButton>
    </MudCardActions>
</MudCard>

@code
{
    private void UploadFiles(InputFileChangeEventArgs e)
    {
        model.ScreenrightsFile = e.File;
    }
}