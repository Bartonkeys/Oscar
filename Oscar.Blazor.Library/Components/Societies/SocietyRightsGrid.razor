@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@using Oscar.Core.Enums
@using Oscar.Infrastructure.Features.Series.Queries

@if (Loading)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true"/>
}
else
{
    <MudCard>
        <MudExpansionPanels>
            <MudExpansionPanel Text="Add Right">
                <MudItem xs="12">
                    <MudAutocomplete T="RightsTypeDto" Label="Rights" SearchFunc="@SearchRightsTypes" OpenIcon="@Icons.Material.Filled.Landscape"
                                     ResetValueOnEmptyText="true" ToStringFunc="dto => dto?.Description"
                                     CoerceText="true" CoerceValue="false" @bind-Value="_model.RightsType"
                                     For="@(() => _model.RightsType)"/>
                </MudItem>
                <MudAutocomplete T="CountryDto" Label="Countries" @bind-Value="_model.Country" For="@(() => _model.Country)" Required="false"
                                 SearchFunc="@SearchCountries" ToStringFunc="@(e=> e==null?null : $"{e.Name}")">
                    <MoreItemsTemplate>
                        <MudText Align="Align.Center" Class="px-4 py-1">
                            Only the first 10 items are shown
                        </MudText>
                    </MoreItemsTemplate>
                </MudAutocomplete>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ma-2" OnClick="@AddSocietyRight">Add</MudButton>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudTable Items="_rights" Hover="true" SortLabel="Sort By" Elevation="0" Loading="@Loading" Filter="new Func<SocietyRightsDto, bool>(Filter)" @bind-SelectedItem="_selectedItem" Dense="true" >
            <ToolBarContent>
                <MudText Typo="Typo.h6">Rights</MudText>
                <MudSpacer/>
                <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0">
                </MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Rights Type</MudTh>
                <MudTh>Country</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="RightsType">@context.RightsType?.Name - @context.RightsType?.Description</MudTd>
                @if (context.Country != null)
                {
                    <MudTd DataLabel="Country">@context.Country.Description</MudTd>
                }
                else
                {
                    <MudTd DataLabel="Country">Not set</MudTd>
                }
                <MudTd DataLabel="Delete">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="delete" OnClick="() => DeleteRight(context)"></MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No matching records found</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 50, 100 }"/>
            </PagerContent>
        </MudTable>
    </MudCard>
}