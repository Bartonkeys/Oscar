@inherits Oscar.Blazor.Library.Common.OscarComponentBase
<MudCard Class="ma-3 pa-5" Style="@Style" Elevation="5">
    @Header
    <MudPaper Elevation="0">
        <MudAutocomplete T="ChannelDto" Label="@ListLabel" @bind-Value="_channel" For="@(() => _channel)" Required="false"
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Description}")" @onblur="onChange" Dense="true" Margin="Margin.Dense">
            <MoreItemsTemplate>
                <MudText Align="Align.Center" Class="px-4 py-1">
                    Only the first 10 items are shown
                </MudText>
            </MoreItemsTemplate>
        </MudAutocomplete>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddChannel" Size="Size.Small">Add</MudButton>
    </MudPaper>

    <MudTable Items="@Value" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info" Dense="true" >
        <RowTemplate>
            <MudTd Style="width: 90%;" Class="grey lighten-3 pa-0 pl-2">
                @context.Channel.Description
            </MudTd>
            <MudTd Style="width: 10%;" Class="grey lighten-3 pa-0 pl-2">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="delete" OnClick="@((e) => RemoveChannel(context.Channel))"></MudIconButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
    
</MudCard>
