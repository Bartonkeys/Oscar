@* Credit: https://tobiasahlin.com/spinkit/ *@

@if (SpinnerStyle == SpinnerType.Wave)
{
    <div class="spinner-wave">
        <div class="rect1"></div>
        <div class="rect2"></div>
        <div class="rect3"></div>
        <div class="rect4"></div>
        <div class="rect5"></div>
    </div>
}
else if (SpinnerStyle == SpinnerType.Cube)
{
    <div class="sk-cube-grid">
        <div class="sk-cube sk-cube1"></div>
        <div class="sk-cube sk-cube2"></div>
        <div class="sk-cube sk-cube3"></div>
        <div class="sk-cube sk-cube4"></div>
        <div class="sk-cube sk-cube5"></div>
        <div class="sk-cube sk-cube6"></div>
        <div class="sk-cube sk-cube7"></div>
        <div class="sk-cube sk-cube8"></div>
        <div class="sk-cube sk-cube9"></div>
    </div>
}
else if (SpinnerStyle == SpinnerType.Default)
{
    <div class="sk-chase">
        <div class="sk-chase-dot"></div>
        <div class="sk-chase-dot"></div>
        <div class="sk-chase-dot"></div>
        <div class="sk-chase-dot"></div>
        <div class="sk-chase-dot"></div>
        <div class="sk-chase-dot"></div>
    </div>
}
else if (SpinnerStyle == SpinnerType.Bounce)
{
    <div class="spinner-bounce">
        <div class="double-bounce1"></div>
        <div class="double-bounce2"></div>
    </div>
}
else if (SpinnerStyle == SpinnerType.ChasingDots)
{
    <div class="spinner-dots">
        <div class="dot1"> </div>
        <div class="dot2"> </div>
    </div>
}
else if (SpinnerStyle == SpinnerType.Rotate)
{
    <div class="spinner-rotate"></div>
}
else if (SpinnerStyle == SpinnerType.ThreeDots)
{
    <div class="spinner-3dots">
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
}
else if (SpinnerStyle == SpinnerType.FoldingCube)
{
    <div class="sk-folding-cube">
        <div class="sk-cube1 sk-cube"></div>
        <div class="sk-cube2 sk-cube"></div>
        <div class="sk-cube4 sk-cube"></div>
        <div class="sk-cube3 sk-cube"></div>
    </div>
}
<div class="h5 d-flex text-center">
    <strong>@SpinnerText</strong>
</div>
