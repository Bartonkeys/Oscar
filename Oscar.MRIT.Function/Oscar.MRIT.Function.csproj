  <ItemGroup>
    <ProjectReference Include="..\Oscar.DI\Oscar.DI.csproj" />
    <ProjectReference Include="..\Oscar.MRIT.Core\Oscar.MRIT.Core.csproj" />
    <ProjectReference Include="..\Oscar.Mrit\Oscar.Mrit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="client.ncconf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="config.ncconf">
