@page "/merlinSocietyList"
@inherits Oscar.Blazor.Library.Common.OscarComponentBase
@using Oscar.Blazor.Components

<PageTitle>@Title</PageTitle>

<Spinner @ref="@SpinnerControl" SpinnerStyle="SpinnerType.Cube" SpinnerText="@StatusText" />

<MudText Typo="Typo.h6">@Title</MudText>

<MudCard>
    <MudForm>
        <MudCardContent>
            <div class="d-flex">
                <InputFile id="fileInput" OnChange="OnFileChange" hidden />

                <MudButton HtmlTag="label"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           for="fileInput">
                    Browse
                </MudButton>
                @if (selectedFile != null)
                {
                    <div class="ml-2"> <!-- Add left margin -->
                        <MudText>File: @selectedFile.Name</MudText>
                    </div>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ml-auto" OnClick="@(async () => await OnImportFromExcelClick())">Import</MudButton>
            </div>
        </MudCardContent>
    </MudForm>
</MudCard>

<MudTable Items="@_merlinSocietyItems" T="MerlinSocietyDto"
          class="mt-4" SortLabel="Sort By" Virtualize="true" Breakpoint="Breakpoint.Sm"
          RowClass="cursor-pointer" Dense="true" Bordered="true" Hover="true" Striped="true">
    <ToolBarContent>
        <MudButton StartIcon="@Icons.Material.Filled.FileDownload" Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" Class="ml-auto" OnClick="@(async () => await OnExportToExcelClick())">Export</MudButton>
        <MudSpacer />
    </ToolBarContent>

