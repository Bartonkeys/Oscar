@page "/importRequest"
@using Oscar.Blazor.Library.Components.Imports
@inherits Oscar.Blazor.Library.Common.OscarComponentBase

<PageTitle>Import Status</PageTitle>

<Oscar.Blazor.Library.Components.Imports.CreateImportDrawer OpenImportDrawer="@openImportCreate" Clients="@_clients" OnSubmit="Refresh" ImportWorks="true" Title="New Works Import"/>
<ImportsDrawer id="@requestId" OpenImportDrawer="@openImport" IsSuccess="@isSuccess" OnReSubmit="Refresh"/>

<MudGrid>
    <MudItem xs="6">
        <MudButton OnClick="@OpenImportCreate" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Create New Works Import</MudButton>
    </MudItem>
    <MudItem xs="6">
    </MudItem>
    <MudItem xs="12">
        <MudTable Dense="true"  ServerData="@(new Func<TableState, Task<TableData<WorksImportRequestDto>>>(ServerReload))" Hover="true" @ref="table" Loading="@_loading">
            <ToolBarContent>
                <MudText Typo="Typo.h6">New Works</MudText>
                <MudSpacer/>
                <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="Search" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Client</MudTh>
                <MudTh>Catalogue</MudTh>
                <MudTh>Requested By</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Modified</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>View</MudTh>
                <MudTh>Rollback</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.ClientName</MudTd>
                <MudTd DataLabel="Title">@context.CatalogueName</MudTd>
                <MudTd DataLabel="RequestedBy">@context.RequestedBy</MudTd>
                <MudTd DataLabel="CreationDate">@context.CreationDate</MudTd>
                <MudTd DataLabel="LastModified">@context.LastModified</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip Label="true" Color="@GetColour(context.Status)" Size="Size.Small" Class="ml-auto mud-elevation-25">@context.Status.ToString()</MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" aria-label="edit" OnClick="() => OpenImportsDrawer(context.Id, context.Status)"></MudIconButton>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="delete" OnClick="() => Rollback(context.Id)"></MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No matching records found</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager/>
            </PagerContent>
        </MudTable>
    </MudItem>
</MudGrid>