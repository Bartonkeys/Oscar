@page "/registrationSearch"
@inherits Oscar.Blazor.Library.Common.OscarComponentBase

<PageTitle>Registration Search</PageTitle>

<MudTable ServerData="@(new Func<TableState, Task<TableData<RegistrationDisplayDto>>>(ServerReload))"
          Hover="true" @ref="table" Loading="@_loading"
          GroupBy="@_groupDefinition"
          GroupHeaderStyle="background-color:var(--mud-palette-background-grey)"
          GroupFooterClass="mb-4"
          Dense="true"
          MultiSelection="true">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Registrations</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(OnSearchByTitle)" Placeholder="Search by Title" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>

    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortLabel="Id" SortBy="new Func<ReportDto, object>(x => x.Id)">Id</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="Society" SortBy="new Func<RegistrationDisplayDto, object>(x => x.SocietyName)">Society</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="Client" SortBy="new Func<RegistrationDisplayDto, object>(x => x.ClientName)">Client</MudTableSortLabel></MudTh>
        <MudTh>Works Title</MudTh>
        <MudTh></MudTh>

    </HeaderContent>
    <GroupHeaderTemplate>
        <MudTh Class="mud-table-cell-custom-group" colspan="5">
            @($"{context.GroupName}: {context.Key}")
            @if (context.Items.FirstOrDefaultDynamic().RegistrationBatch.RegisterStatus == RegisterStatus.Batch_Export_Success)
            {
               @(" : ")
               <MudLink Href="@context.Items.FirstOrDefaultDynamic().RegistrationBatch.RegistrationBatchResultPublicUrl">Download Link</MudLink>

            }
        </MudTh>
    </GroupHeaderTemplate>
    <RowTemplate>
        <MudTd DataLabel="Batch Id">@context.RegistrationBatch.BatchId</MudTd>
        <MudTd DataLabel="Society Name">@context.SocietyName</MudTd>
        <MudTd DataLabel="Client Name">@context.ClientName</MudTd>
        <MudTd DataLabel="Works Title">@String.Join(", ", context.Titles.Select(s => s.Title))</MudTd>
        <MudTd DataLabel="ReportActions">
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="delete" OnClick="() => DeleteRegistration(context)"></MudIconButton>
        </MudTd>

    </RowTemplate>
    <GroupFooterTemplate>
        <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" colspan="5">
            @if (context.Items.FirstOrDefaultDynamic().RegistrationBatch.RegisterStatus == RegisterStatus.Batch_Export_Success)
            {
                <MudLink Href="@context.Items.FirstOrDefaultDynamic().RegistrationBatch.RegistrationBatchResultPublicUrl">Download Link</MudLink>

            }
        </MudTh>
    </GroupFooterTemplate>
    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
