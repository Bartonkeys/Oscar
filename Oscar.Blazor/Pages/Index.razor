@page "/"
@inherits Oscar.Blazor.Library.Common.OscarComponentBase

<PageTitle>Dashboard</PageTitle>

<Spinner @ref="@SpinnerControl" SpinnerText="@StatusText" />

<div class="d-flex align-center justify-space-between mb-6">
    <div>
        <MudText Typo="Typo.h5">Dashboard</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Works across the Oscar catalogue</MudText>
    </div>
    <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Icon="@Icons.Material.Rounded.Inventory2">
        @string.Format("{0:#,0}", data.Sum()) total
    </MudChip>
</div>

<MudGrid Spacing="4">
    @foreach (var tile in Tiles)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="oscar-surface oscar-stat pa-4 d-flex align-center gap-3" Elevation="0">
                <div class="oscar-stat-icon" style="@TileIconStyle(tile.Color)">
                    <MudIcon Icon="@tile.Icon" Color="@tile.Color" />
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@tile.Label</MudText>
                    <MudText Typo="Typo.h5">@string.Format("{0:#,0}", tile.Count)</MudText>
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Class="oscar-surface pa-6 mt-6" Elevation="0">
    <MudText Typo="Typo.h6" Class="mb-1">Works by type</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Share of the catalogue by work type</MudText>

    @if (data.Sum() > 0)
    {
        <div class="d-flex justify-center">
            <MudChart T="double" ChartType="ChartType.Donut" Width="320px" Height="320px"
                      ChartSeries="@Series" ChartLabels="@labels"
                      LegendPosition="Position.Bottom" />
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            No works found yet, so there is nothing to chart.
        </MudAlert>
    }
</MudPaper>
