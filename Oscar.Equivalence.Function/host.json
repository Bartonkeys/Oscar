{
  "version": "2.0",
  "extensions": {
    "durableTask": {
      "storageProvider": {
        "controlQueueBatchSize": 1,
        "partitionCount": 1
      },
      "maxConcurrentActivityFunctions": 1,
      "maxConcurrentOrchestratorFunctions": 1
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Oscar.Function": "Information"
    }
  },
  "functionTimeout": "-1"
}